<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- introduce autowire byName  -->
    
	<!--  
	<bean id="payment" class="spring.Payment" autowire="byName" />
	<bean id="cc" class="spring.CreditCard" />
	<bean id="dopayment" class="spring.Upi"  />
	
	-->
	
	<!-- introduce autowire byType  -->
	<bean id="payment" class="spring.Payment" autowire="byType" />
	<bean id="cc" class="spring.CreditCard" primary="true" /> <!-- shows ambiuity error so we give preference using primary attribute -->
	<bean id="upi" class="spring.Upi"  />
	
</beans>